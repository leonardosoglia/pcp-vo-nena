# Copie este arquivo para `.streamlit/secrets.toml` e preencha com a URL real.
# O arquivo `secrets.toml` (sem .example) está no .gitignore — NUNCA é commitado.
#
# Onde obter a URL no Supabase:
#   Project Settings → Database → Connection string → "Connection pooling"
#   (porta 6543, NÃO a porta 5432 direta)
#
# Formato:
#   postgresql://postgres.<projeto>:<senha>@<host>:6543/postgres

DATABASE_URL = "postgresql://postgres.xxxxxxxxxxxx:SENHA_AQUI@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
